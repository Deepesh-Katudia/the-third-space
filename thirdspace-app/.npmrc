# The rules-unit-testing package peers on firebase@^12 while the app deliberately runs
# firebase@^11 (the version Expo SDK 54 and the app's own code are built against). npm
# treats that as an unresolvable conflict, so every install here needs legacy peer
# resolution. Recording it in the repo rather than relying on whoever installs remembering
# a flag: an EAS build server runs its own install, and a machine without this file gets a
# hard ERESOLVE failure instead of a build.
legacy-peer-deps=true

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isEventOwner(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.venueId == request.auth.uid;
    }

    function isRegistered(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid));
    }

    function isEventChatMember(eventId) {
      return isRegistered(eventId) || isEventOwner(eventId);
    }

    // The caller's own registration doc appears in this same batch (register flow).
    function registersSelf(eventId) {
      return !exists(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid));
    }

    // The caller's own registration doc is removed in this same batch (cancel flow).
    function unregistersSelf(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid));
    }

    function tierFor(points) {
      return points >= 1500 ? 'Insider' : (points >= 500 ? 'Regular' : 'Newcomer');
    }

    function isValidPointsDelta(delta) {
      return delta == 50 || delta == -50 || delta == -500 || delta == -800;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /pushTokens/{token} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Phone -> email lookup index for sign-in. Written only by Cloud Functions
    // via the Admin SDK (which bypasses rules); clients never touch it directly.
    match /phoneIndex/{phone} {
      allow read, write: if false;
    }

    match /venues/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['points', 'tier'])
          || (
            isValidPointsDelta(request.resource.data.points - resource.data.points)
            && request.resource.data.tier == tierFor(request.resource.data.points)
          )
        );

      match /redemptions/{redemptionId} {
        allow read, create: if signedIn() && request.auth.uid == uid;
      }
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.venueId == request.auth.uid
        && exists(/databases/$(database)/documents/venues/$(request.auth.uid));
      // Owner can update anything. A non-owner may only touch registeredCount, and
      // only by ±1 in lockstep with creating/deleting their OWN registration in the
      // same batch — so the counter can't be inflated, zeroed, or nudged for anyone else.
      allow update: if signedIn() && (
        resource.data.venueId == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount']) && (
            (request.resource.data.registeredCount == resource.data.registeredCount + 1 && registersSelf(eventId)) ||
            (request.resource.data.registeredCount == resource.data.registeredCount - 1 && unregistersSelf(eventId))
          )
        )
      );
      allow delete: if signedIn() && resource.data.venueId == request.auth.uid;

      match /registrations/{uid} {
        allow read: if signedIn() && (
          request.auth.uid == uid ||
          isEventOwner(eventId) ||
          exists(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid))
        );
        allow create: if signedIn() && request.auth.uid == uid;
        // Registrant cancels their own; the venue owner deletes all when cancelling the event.
        allow delete: if signedIn() && (request.auth.uid == uid || isEventOwner(eventId));
      }

      match /announcements/{announcementId} {
        allow read: if signedIn() && isEventChatMember(eventId);
        allow create: if signedIn() && isEventOwner(eventId)
          && request.resource.data.authorUid == request.auth.uid;
        // No update/delete this sub-project.
      }
    }

    match /eventChats/{eventId} {
      allow read: if signedIn() && isEventChatMember(eventId);
      allow create, update: if signedIn() && isEventChatMember(eventId);

      match /messages/{messageId} {
        allow read: if signedIn() && isEventChatMember(eventId);
        allow create: if signedIn() && isEventChatMember(eventId)
          && request.resource.data.authorUid == request.auth.uid;
      }
    }

    match /conversations/{convId} {
      // A not-yet-created conversation must read as absent, not denied: the first DM
      // probes this doc to decide create-vs-append, and `resource` is null until then.
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow update, delete: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
          && (
            get(/databases/$(database)/documents/conversations/$(convId)).data.status == 'open' ||
            get(/databases/$(database)/documents/conversations/$(convId)).data.requestedBy == request.auth.uid
          );
        allow delete: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }
    }

    match /users/{uid}/chatReads/{threadId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.target != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.target;
      allow delete: if signedIn() && resource.data.follower == request.auth.uid;
    }
  }
}

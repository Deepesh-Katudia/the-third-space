rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isEventOwner(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.venueId == request.auth.uid;
    }

    function isRegistered(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid));
    }

    function isEventChatMember(eventId) {
      return isRegistered(eventId) || isEventOwner(eventId);
    }

    // The caller's own registration doc appears in this same batch (register flow).
    function registersSelf(eventId) {
      return !exists(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid));
    }

    // The caller's own registration doc is removed in this same batch (cancel flow).
    function unregistersSelf(eventId) {
      return exists(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid))
        && !existsAfter(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid));
    }

    function tierFor(points) {
      return points >= 1500 ? 'Insider' : (points >= 500 ? 'Regular' : 'Newcomer');
    }

    function isValidPointsDelta(delta) {
      return delta == 50 || delta == -50 || delta == -500 || delta == -800;
    }

    // hasOnly (used on the socials write rule) bounds key NAMES only — it says
    // nothing about value type, size, or character set. This bounds the value too:
    // absent is fine (that's "not set"), but if present it must be a string within
    // the platform's handle length range AND matching its character-set pattern —
    // matching utils/socials.ts exactly, so the client's own validation can never
    // accept something the rules reject (or the reverse). Clearing a handle means
    // omitting the key, not `''` — that's why minLen is never 0.
    function validSocial(key, minLen, maxLen, pattern) {
      return !(key in request.resource.data)
        || (request.resource.data[key] is string
            && request.resource.data[key].size() >= minLen
            && request.resource.data[key].size() <= maxLen
            && request.resource.data[key].matches(pattern));
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;

      // `role` is write-once. There is no role switching in the app, and the UI is
      // not what enforces that — this is. The doc still takes ordinary updates
      // (pushEnabled, birthdate, registeredEventIds), so this gates the one field
      // rather than the write. On any update `request.resource.data` is the
      // POST-write document, so a write that never mentions role still carries the
      // stored one — which is why the comparison, not the key check, does the work.
      // `.get('role', ...)` defaults rather than dereferencing: a doc with no role
      // yet would make a bare `resource.data.role` raise an evaluation error rather
      // than return false. Same trap the conversations read guards against.
      allow update: if signedIn() && request.auth.uid == uid
        && (!('role' in request.resource.data)
            || request.resource.data.role == resource.data.get('role', request.resource.data.role));

      // No delete: deleting and recreating the doc would be a role switch by another
      // name. Nothing in the app deletes it.

      match /pushTokens/{token} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Phone -> email lookup index for sign-in. Written only by Cloud Functions
    // via the Admin SDK (which bypasses rules); clients never touch it directly.
    match /phoneIndex/{phone} {
      allow read, write: if false;
    }

    match /venues/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    match /profiles/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['points', 'tier'])
          || (
            isValidPointsDelta(request.resource.data.points - resource.data.points)
            && request.resource.data.tier == tierFor(request.resource.data.points)
          )
        );

      match /redemptions/{redemptionId} {
        allow read, create: if signedIn() && request.auth.uid == uid;
      }

      // Handles are kept OFF the profile document on purpose: profiles/{uid} is
      // `allow read: if signedIn()`, so anything stored there is readable by every
      // signed-in member no matter what the UI renders. A mutual follow is two edge
      // docs, so it is provable here with two exists() calls — well inside the
      // per-request document access budget.
      match /private/socials {
        // Doc ids are built by string concatenation, never by inspecting the
        // follower/target fields — safe today because no supported auth provider
        // (email/password, Apple, Google) can mint a uid containing '_'. If a future
        // auth path ever could, 'a_b_c' would parse ambiguously and this needs revisiting.
        allow read: if signedIn() && (
          request.auth.uid == uid || (
            exists(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)) &&
            exists(/databases/$(database)/documents/follows/$(uid + '_' + request.auth.uid))
          )
        );
        // hasOnly bounds the key set; validSocial bounds each present value to a
        // non-empty string within its platform's handle length. Together they stop
        // the doc being used as unbounded (or wrongly-typed) storage on a path other
        // members can read. create/update are split from delete because on delete
        // request.resource is null and .data would raise an evaluation error —
        // clearing a handle goes through setDoc(doc, {}), not deleteDoc.
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['instagram', 'tiktok', 'x'])
          && validSocial('instagram', 1, 30, '^[a-z0-9._]+$')
          && validSocial('tiktok', 2, 24, '^[a-z0-9._]+$')
          && validSocial('x', 1, 15, '^[a-z0-9_]+$');
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.venueId == request.auth.uid
        && exists(/databases/$(database)/documents/venues/$(request.auth.uid));
      // Owner can update anything. A non-owner may only touch registeredCount, and
      // only by ±1 in lockstep with creating/deleting their OWN registration in the
      // same batch — so the counter can't be inflated, zeroed, or nudged for anyone else.
      allow update: if signedIn() && (
        resource.data.venueId == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount']) && (
            (request.resource.data.registeredCount == resource.data.registeredCount + 1 && registersSelf(eventId)) ||
            (request.resource.data.registeredCount == resource.data.registeredCount - 1 && unregistersSelf(eventId))
          )
        )
      );
      allow delete: if signedIn() && resource.data.venueId == request.auth.uid;

      match /registrations/{uid} {
        allow read: if signedIn() && (
          request.auth.uid == uid ||
          isEventOwner(eventId) ||
          exists(/databases/$(database)/documents/events/$(eventId)/registrations/$(request.auth.uid))
        );
        allow create: if signedIn() && request.auth.uid == uid;
        // Registrant cancels their own; the venue owner deletes all when cancelling the event.
        allow delete: if signedIn() && (request.auth.uid == uid || isEventOwner(eventId));
      }

      match /announcements/{announcementId} {
        allow read: if signedIn() && isEventChatMember(eventId);
        allow create: if signedIn() && isEventOwner(eventId)
          && request.resource.data.authorUid == request.auth.uid;
        // No update/delete this sub-project.
      }
    }

    match /eventChats/{eventId} {
      allow read: if signedIn() && isEventChatMember(eventId);
      allow create, update: if signedIn() && isEventChatMember(eventId);

      match /messages/{messageId} {
        allow read: if signedIn() && isEventChatMember(eventId);
        allow create: if signedIn() && isEventChatMember(eventId)
          && request.resource.data.authorUid == request.auth.uid;
      }
    }

    match /conversations/{convId} {
      // A not-yet-created conversation must read as absent, not denied: the first DM
      // probes this doc to decide create-vs-append, and `resource` is null until then.
      allow read: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      allow update, delete: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending';

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
          && (
            get(/databases/$(database)/documents/conversations/$(convId)).data.status == 'open' ||
            get(/databases/$(database)/documents/conversations/$(convId)).data.requestedBy == request.auth.uid
          );
        allow delete: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
      }
    }

    match /users/{uid}/chatReads/{threadId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.target != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.target;
      allow delete: if signedIn() && resource.data.follower == request.auth.uid;
    }
  }
}
